---
/**
 * Логотип «ОТ ⟲ ВИНТА» — векторная копия оригинального логотипа клуба
 * (геометрия — src/lib/logo.ts, сборка SVG — src/lib/logo-svg.ts).
 */
import { site } from '@/data/site';
import { logoSvg } from '@/lib/logo-svg';

interface Props {
  variant?: 'full' | 'compact';
  /** уникальный префикс id градиентов, если логотипов на странице несколько */
  uid: string;
  class?: string;
  decorative?: boolean;
}

const { variant = 'compact', uid, class: className, decorative = false } = Astro.props;
const svg = logoSvg({
  variant,
  uid,
  className: ['prop-hover block h-auto', className].filter(Boolean).join(' '),
  title: decorative ? undefined : `${site.name} — ${site.slogan}`,
});
---

<Fragment set:html={svg} />
