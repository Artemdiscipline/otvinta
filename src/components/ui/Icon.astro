---
/**
 * Иконки: lucide (инлайн SVG) + упрощённые знаки мессенджеров в том же стиле.
 * По умолчанию декоративные (aria-hidden). Если иконка несёт смысл — передайте label.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Baby from '@lucide/astro/icons/baby';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Bath from '@lucide/astro/icons/bath';
import Bike from '@lucide/astro/icons/bike';
import Calculator from '@lucide/astro/icons/calculator';
import Calendar from '@lucide/astro/icons/calendar';
import Camera from '@lucide/astro/icons/camera';
import Car from '@lucide/astro/icons/car';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import CircleCheckBig from '@lucide/astro/icons/circle-check-big';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Clock from '@lucide/astro/icons/clock';
import Compass from '@lucide/astro/icons/compass';
import Copy from '@lucide/astro/icons/copy';
import Crosshair from '@lucide/astro/icons/crosshair';
import Drone from '@lucide/astro/icons/drone';
import Droplets from '@lucide/astro/icons/droplets';
import ExternalLink from '@lucide/astro/icons/external-link';
import Flame from '@lucide/astro/icons/flame';
import Fuel from '@lucide/astro/icons/fuel';
import Gauge from '@lucide/astro/icons/gauge';
import Gift from '@lucide/astro/icons/gift';
import Goal from '@lucide/astro/icons/goal';
import HeartHandshake from '@lucide/astro/icons/heart-handshake';
import House from '@lucide/astro/icons/house';
import Info from '@lucide/astro/icons/info';
import Leaf from '@lucide/astro/icons/leaf';
import LifeBuoy from '@lucide/astro/icons/life-buoy';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Magnet from '@lucide/astro/icons/magnet';
import MapPin from '@lucide/astro/icons/map-pin';
import Medal from '@lucide/astro/icons/medal';
import Menu from '@lucide/astro/icons/menu';
import Mountain from '@lucide/astro/icons/mountain';
import MountainSnow from '@lucide/astro/icons/mountain-snow';
import Navigation from '@lucide/astro/icons/navigation';
import Package from '@lucide/astro/icons/package';
import PartyPopper from '@lucide/astro/icons/party-popper';
import Percent from '@lucide/astro/icons/percent';
import Phone from '@lucide/astro/icons/phone';
import Plane from '@lucide/astro/icons/plane';
import Play from '@lucide/astro/icons/play';
import Quote from '@lucide/astro/icons/quote';
import Route from '@lucide/astro/icons/route';
import Send from '@lucide/astro/icons/send';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Ship from '@lucide/astro/icons/ship';
import Shirt from '@lucide/astro/icons/shirt';
import Smartphone from '@lucide/astro/icons/smartphone';
import Snowflake from '@lucide/astro/icons/snowflake';
import Sparkles from '@lucide/astro/icons/sparkles';
import Stamp from '@lucide/astro/icons/stamp';
import Star from '@lucide/astro/icons/star';
import Sun from '@lucide/astro/icons/sun';
import Target from '@lucide/astro/icons/target';
import Tent from '@lucide/astro/icons/tent';
import ThermometerSnowflake from '@lucide/astro/icons/thermometer-snowflake';
import Ticket from '@lucide/astro/icons/ticket';
import Timer from '@lucide/astro/icons/timer';
import Trees from '@lucide/astro/icons/trees';
import Trophy from '@lucide/astro/icons/trophy';
import Truck from '@lucide/astro/icons/truck';
import Users from '@lucide/astro/icons/users';
import Utensils from '@lucide/astro/icons/utensils';
import Video from '@lucide/astro/icons/video';
import WavesHorizontal from '@lucide/astro/icons/waves-horizontal';
import Wind from '@lucide/astro/icons/wind';
import X from '@lucide/astro/icons/x';
import Zap from '@lucide/astro/icons/zap';
import type { IconName } from '@/data/types';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  'stroke-width'?: number;
}

const { name, size = 22, class: className, label, 'stroke-width': sw = 2 } = Astro.props;

const lucide = {
  snowflake: Snowflake,
  sun: Sun,
  leaf: Leaf,
  mountain: Mountain,
  'mountain-snow': MountainSnow,
  waves: WavesHorizontal,
  wind: Wind,
  sparkles: Sparkles,
  users: Users,
  gift: Gift,
  tent: Tent,
  trophy: Trophy,
  shirt: Shirt,
  lightbulb: Lightbulb,
  camera: Camera,
  drone: Drone,
  flame: Flame,
  baby: Baby,
  'badge-check': BadgeCheck,
  'map-pin': MapPin,
  clock: Clock,
  timer: Timer,
  phone: Phone,
  calendar: Calendar,
  star: Star,
  percent: Percent,
  bath: Bath,
  plane: Plane,
  ship: Ship,
  route: Route,
  gauge: Gauge,
  'shield-check': ShieldCheck,
  'life-buoy': LifeBuoy,
  truck: Truck,
  package: Package,
  smartphone: Smartphone,
  stamp: Stamp,
  magnet: Magnet,
  trees: Trees,
  house: House,
  utensils: Utensils,
  crosshair: Crosshair,
  target: Target,
  goal: Goal,
  'party-popper': PartyPopper,
  'clipboard-list': ClipboardList,
  video: Video,
  navigation: Navigation,
  car: Car,
  info: Info,
  zap: Zap,
  droplets: Droplets,
  'heart-handshake': HeartHandshake,
  medal: Medal,
  fuel: Fuel,
  compass: Compass,
  'thermometer-snowflake': ThermometerSnowflake,
  bike: Bike,
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  'chevron-down': ChevronDown,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  play: Play,
  x: X,
  menu: Menu,
  check: Check,
  quote: Quote,
  calculator: Calculator,
  copy: Copy,
  'circle-check-big': CircleCheckBig,
  'external-link': ExternalLink,
  send: Send,
  ticket: Ticket,
} as const;

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
const Lucide = name in lucide ? lucide[name as keyof typeof lucide] : null;
---

{
  Lucide ? (
    <Lucide size={size} stroke-width={sw} class={className} {...a11y} />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={sw}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      {...a11y}
    >
      {name === 'telegram' && (
        <>
          <path d="M21.5 3.5 2.5 11l6.5 2.5 2.5 7 3.5-4.5 5 3.5z" />
          <path d="m9 13.5 12.5-10" />
        </>
      )}
      {name === 'whatsapp' && (
        <>
          <path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1z" />
          <path d="M9.2 8.5c.1-.4.4-.6.8-.6h.4c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .4-.1.6l-.5.6c.6 1.2 1.5 2.1 2.7 2.7l.6-.5c.2-.1.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.4c0 .4-.2.7-.6.8-1.8.6-6.8-2.6-6.9-6.9Z" />
        </>
      )}
      {name === 'vk' && (
        <path
          fill="currentColor"
          stroke="none"
          d="M3 7.2h3.1c.3 3.4 1.9 5.4 3.3 5.7V7.2h2.9v3.3c1.4-.2 2.9-1.9 3.4-3.3h2.9c-.4 2.1-2 3.7-3.1 4.4 1.1.6 3 2 3.7 4.8h-3.2c-.6-1.9-2-3.2-3.7-3.4v3.4h-.4C7.1 16.4 3.3 12.9 3 7.2Z"
        />
      )}
      {name === 'max' && (
        <>
          <path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z" />
          <path d="M8 15V9.5l4 3.5 4-3.5V15" />
        </>
      )}
      {name === 'instagram' && (
        <>
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
        </>
      )}
    </svg>
  )
}
