---
/** FAQ: нативный аккордеон <details> + разметка FAQPage. */
import type { FaqItem } from '@/data/faq';
import { faqLd } from '@/lib/schema';
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Частые вопросы' } = Astro.props;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHead id="faq-title" eyebrow="FAQ" title={title} lead="Не нашли ответа — напишите нам в мессенджер или позвоните, подскажем." />
    </div>
    <div class="grid gap-3">
      {
        items.map((f, i) => (
          <details class="faq-item reveal card group" name="faq" style={`--d:${i * 40}ms`}>
            <summary class="flex items-center justify-between gap-4 rounded-[1.25rem] p-5 text-left font-bold sm:p-6 sm:text-lg">
              {f.q}
              <span class="faq-chevron grid size-9 shrink-0 place-items-center rounded-full border border-line text-glow transition-transform duration-300">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="px-5 pb-6 text-muted sm:px-6">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd(items))} />
</section>
