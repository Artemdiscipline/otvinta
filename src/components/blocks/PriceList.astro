---
/** Простой прайс по группам каталога (гидроциклы, флайборд). На мобиле — карточки. */
import type { CatalogGroup } from '@/data/prices';
import type { ServiceId } from '@/data/types';
import BookButton from '../ui/BookButton.astro';
import PriceTag from '../ui/PriceTag.astro';

interface Props {
  groups: CatalogGroup[];
  service: ServiceId;
}
const { groups, service } = Astro.props;
---

<div class="grid gap-6">
  {
    groups.map((g) => (
      <div class="card overflow-hidden p-2 md:p-4">
        <table class="ptable">
          <caption class="px-4 pt-3 pb-2 text-left font-display text-lg font-bold">{g.label}</caption>
          <thead>
            <tr>
              <th scope="col">Что</th>
              <th scope="col">Стоимость</th>
              <th scope="col"><span class="sr-only">Бронирование</span></th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((i) => (
              <tr>
                <td data-head class="font-semibold">{i.label.replace(/^(Пляжный|Спортивный): /, '')}</td>
                <td data-label="Стоимость">
                  <span>
                    <PriceTag price={i.price} clarify={i.clarify} class="text-lg" />
                    {i.unit && <span class="ml-1 text-xs text-muted">{i.unit}</span>}
                  </span>
                </td>
                <td data-label="" class="md:text-right">
                  <BookButton service={service} program={i.id} size="sm" label="Бронь" icon={false} class="w-full md:w-auto" />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))
  }
</div>
