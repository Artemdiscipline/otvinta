---
/** Сравнение трасс: таблица на десктопе, карточки на телефоне (.ptable). */
import { pricesMeta, tracks, type TrackTariff } from '@/data/prices';
import type { ServiceId } from '@/data/types';
import BookButton from '../ui/BookButton.astro';
import PriceTag from '../ui/PriceTag.astro';

interface Props {
  list: TrackTariff[];
  service: ServiceId;
  caption: string;
}
const { list, service, caption } = Astro.props;
---

<div class="reveal card overflow-hidden p-2 md:p-4">
  <table class="ptable">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Трасса</th>
        <th scope="col">Для кого</th>
        <th scope="col">Длительность</th>
        <th scope="col">Кто едет</th>
        <th scope="col">Стоимость</th>
        <th scope="col"><span class="sr-only">Бронирование</span></th>
      </tr>
    </thead>
    <tbody>
      {
        list.flatMap((t) =>
          t.variants.map((v, vi) => (
            <tr>
              <td data-head>
                <span class="flex items-center gap-2.5 font-bold">
                  <span class="track-dot" data-track={t.track} style={`--track:${tracks[t.track].color}`} />
                  {t.title}
                </span>
                {v.tech && <span class="mt-1 block text-sm text-muted">{v.tech}</span>}
              </td>
              <td data-label="Для кого" class="text-sm">{vi === 0 ? t.audience : '—'}</td>
              <td data-label="Длительность" class="text-sm whitespace-nowrap">
                <span>{t.duration ?? 'уточняйте'}{t.durationClarify && <span class="clarify" title="Уточняйте у администратора">*</span>}</span>
              </td>
              <td data-label="Кто едет" class="text-sm"><span>{v.capacity ?? t.capacity ?? '—'}{t.conditions && <span class="block text-[#ffb48a]">{t.conditions.join(', ')}</span>}</span></td>
              <td data-label="Стоимость">
                <span>
                  <PriceTag price={v.price} clarify={v.clarify} class="text-lg" />
                  {v.unit && <span class="block text-xs text-muted">{v.unit}</span>}
                </span>
              </td>
              <td data-label="" class="md:text-right">
                <BookButton service={service} program={v.id} size="sm" label="Бронь" icon={false} class="w-full md:w-auto" />
              </td>
            </tr>
          )),
        )
      }
    </tbody>
  </table>
</div>
<p class="mt-4 text-sm text-muted">
  {pricesMeta.disclaimer} Цены обновлены: {pricesMeta.updatedAtLabel}.
</p>
