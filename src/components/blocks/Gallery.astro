---
/** Галерея фото клуба с лайтбоксом на <dialog>. */
import type { PhotoKey } from '@/data/photos';
import { photoAlt, singleImage } from '@/lib/images';
import Icon from '../ui/Icon.astro';
import Pic from '../ui/Pic.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  photos: PhotoKey[];
  title?: string;
  id?: string;
}
const { photos, title = 'Фото с заездов', id = 'gallery' } = Astro.props;
const big = photos.length >= 5;
const items = await Promise.all(photos.map(async (p) => ({ p, full: await singleImage(p, 1600) })));
---

<section class="section" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <SectionHead id={`${id}-title`} eyebrow="Галерея" title={title} />
    <ul class:list={['mt-10 grid auto-rows-[10rem] grid-cols-2 gap-3 sm:auto-rows-[13rem]', big ? 'md:grid-cols-4' : 'md:auto-rows-[16rem] md:grid-cols-3']} data-gallery>
      {
        items.map(({ p, full }, i) => (
          <li class:list={['reveal', big && i === 0 && 'col-span-2 row-span-2', !big && photos.length % 2 === 1 && i === 0 && 'col-span-2 md:col-span-1']} style={`--d:${(i % 4) * 60}ms`}>
            <button
              type="button"
              class="group relative block h-full w-full overflow-hidden rounded-2xl border border-line"
              data-full={full}
              data-alt={photoAlt(p)}
              aria-label={`Открыть фото: ${photoAlt(p)}`}
            >
              <Pic
                photo={p}
                sizes={big && i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 33vw, 50vw'}
                widths={[400, 700, 1000]}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-ink/70 opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">
                <Icon name="arrow-up-right" size={18} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="modal" data-lightbox aria-label="Просмотр фото">
  <div class="flex h-full w-full items-center justify-center p-4" data-modal-backdrop>
    <figure class="modal-panel relative max-h-full max-w-6xl">
      <img alt="" class="max-h-[82dvh] w-auto rounded-2xl object-contain shadow-glow" data-lightbox-img />
      <figcaption class="mt-3 text-center text-sm text-muted" data-lightbox-cap></figcaption>
    </figure>
    <button type="button" class="absolute right-4 top-4 grid size-12 place-items-center rounded-full border border-line bg-ink/80" data-modal-close aria-label="Закрыть">
      <Icon name="x" />
    </button>
    <button type="button" class="absolute left-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full border border-line bg-ink/80" data-lightbox-step="-1" aria-label="Предыдущее фото">
      <Icon name="chevron-left" />
    </button>
    <button type="button" class="absolute right-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full border border-line bg-ink/80" data-lightbox-step="1" aria-label="Следующее фото">
      <Icon name="chevron-right" />
    </button>
  </div>
</dialog>

<script>
  import { initGallery } from '@/scripts/gallery';
  initGallery();
</script>
