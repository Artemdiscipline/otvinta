---
import type { IconName } from '@/data/types';
import Icon from '../ui/Icon.astro';

interface Props {
  steps: { icon: IconName; title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-4 md:grid-cols-3">
  {
    steps.map((s, i) => (
      <li class="reveal card relative overflow-hidden p-6" style={`--d:${i * 90}ms`}>
        <span class="absolute -right-3 -top-6 font-display text-[6rem] font-black text-glow/10">{i + 1}</span>
        <span class="grid size-12 place-items-center rounded-2xl bg-deep text-white shadow-glow-sm">
          <Icon name={s.icon} size={24} />
        </span>
        <h3 class="mt-5 font-display text-lg font-bold">{s.title}</h3>
        <p class="mt-2 text-sm text-muted">{s.text}</p>
      </li>
    ))
  }
</ol>
