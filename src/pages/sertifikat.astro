---
import PageHero from '@/components/sections/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import Pic from '@/components/ui/Pic.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { certificate } from '@/data/offers';
import { pages } from '@/data/pages';
import { catalog, pricesMeta } from '@/data/prices';
import { whatsappNumber } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { formatPrice } from '@/lib/format';
import { servicePageLd } from '@/lib/schema';

const meta = pages.certificate;
const origin = String(Astro.site);
const fallback = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Здравствуйте! Хочу заказать подарочный сертификат.')}`;
---

<Base
  title={meta.title}
  description={meta.description}
  path={meta.path}
  jsonLd={servicePageLd(origin, { name: 'Подарочный сертификат', path: meta.path, crumb: meta.crumb })}
>
  <PageHero
    photo="cert-wood-box"
    eyebrow="Подарок, который запомнится"
    title="Подарочные сертификаты на активный отдых"
    lead={`${certificate.lead} ${certificate.lineup}.`}
    crumbs={[{ name: meta.crumb, path: meta.path }]}
    cta={false}
    facts={[
      { icon: 'smartphone', label: 'Онлайн', value: 'в WhatsApp за 2 минуты' },
      { icon: 'truck', label: 'Доставка', value: 'Яндекс Такси по Казани' },
      { icon: 'gift', label: 'Оформление', value: `${certificate.designs.length} вариантов` },
    ]}
    secondary={{ label: 'Собрать сертификат', href: '#konstruktor', icon: 'gift' }}
  />

  <section class="section" aria-labelledby="any-title">
    <div class="container-x">
      <SectionHead id="any-title" eyebrow="Единый сертификат" title="Получатель сам выберет, на чём кататься" />
      <ul class="reveal mt-8 flex flex-wrap gap-2">
        {
          certificate.activities.map((a) => (
            <li class="chip py-2 text-sm first-letter:uppercase">{a}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="slant bg-surface-grad" aria-labelledby="designs-title">
    <div class="container-x">
      <SectionHead id="designs-title" eyebrow="Оригинальное оформление" title="Сертификат, который хочется открыть" lead="Стоимость оформления зависит от варианта — уточняйте у администратора." />
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
        {
          certificate.designs.map((d, i) => (
            <li class="reveal" style={`--d:${(i % 3) * 70}ms`}>
              <figure class="card card-hover group flex h-full flex-col overflow-hidden">
                <div class="photo-shade relative aspect-[4/3] overflow-hidden">
                  {d.photo ? (
                    <Pic photo={d.photo} sizes="(min-width: 1024px) 33vw, 50vw" widths={[400, 700]} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                  ) : (
                    <Placeholder icon={d.icon} label="фото скоро" />
                  )}
                </div>
                <figcaption class="flex items-center gap-2 p-4 text-sm font-bold sm:text-base">
                  <Icon name={d.icon} size={18} class="shrink-0 text-glow" />
                  {d.title}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="get-title">
    <div class="container-x">
      <SectionHead id="get-title" eyebrow="Как получить" title="Три способа получить сертификат" />
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        {
          certificate.delivery.map((d, i) => (
            <li class="reveal card relative overflow-hidden p-6" style={`--d:${i * 90}ms`}>
              <span class="absolute -right-2 -top-5 font-display text-[5.5rem] font-black text-glow/10">{i + 1}</span>
              <span class="grid size-12 place-items-center rounded-2xl bg-deep text-white shadow-glow-sm">
                <Icon name={d.icon} size={24} />
              </span>
              <h3 class="mt-5 font-display text-lg font-bold">{d.title}</h3>
              <p class="mt-2 text-sm text-muted">{d.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="konstruktor" class="slant-top relative overflow-hidden bg-surface pb-20 md:pb-28" aria-labelledby="builder-title">
    <div class="container-x">
      <SectionHead id="builder-title" eyebrow="Конструктор" title="Соберите сертификат" lead="Три шага — и заявка готова. Администратор подтвердит стоимость и пришлёт сертификат." />
      <form class="mt-10 grid gap-6 lg:grid-cols-[1.5fr_1fr]" data-cert-builder>
        <div class="grid gap-6">
          <fieldset class="reveal card p-5 sm:p-7">
            <legend class="sr-only">Шаг 1. Активность или номинал</legend>
            <p class="flex items-center gap-3 font-display text-lg font-bold">
              <span class="grid size-8 place-items-center rounded-full bg-deep text-sm text-white">1</span> Активность или номинал
            </p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="field sm:col-span-2">
                <label class="field-label" for="cert-activity">Что дарим</label>
                <select id="cert-activity" class="input" name="activity">
                  <option value="any">Любая активность — на сумму (номинал)</option>
                  {
                    catalog.map((c) => (
                      <optgroup label={c.label}>
                        {c.groups.flatMap((g) => g.items).map((i) => (
                          <option value={i.id}>{`${i.label} · ${formatPrice(i.price)}${i.unit ? ` ${i.unit}` : ''}`}</option>
                        ))}
                      </optgroup>
                    ))
                  }
                </select>
              </div>
              <div class="field" data-cert-amount-box>
                <label class="field-label" for="cert-amount">Номинал, ₽</label>
                <input id="cert-amount" class="input" type="number" name="amount" min="1" inputmode="numeric" placeholder="Сумма в рублях" />
              </div>
            </div>
          </fieldset>

          <fieldset class="reveal card p-5 sm:p-7">
            <legend class="sr-only">Шаг 2. Оформление</legend>
            <p class="flex items-center gap-3 font-display text-lg font-bold">
              <span class="grid size-8 place-items-center rounded-full bg-deep text-sm text-white">2</span> Оформление
            </p>
            <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
              {
                certificate.designs.map((d, i) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-line bg-ink/40 p-3 text-sm font-semibold transition hover:border-glow/60 has-[:checked]:border-glow has-[:checked]:bg-deep/30 has-[:checked]:shadow-glow-sm has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-glow">
                    <input type="radio" name="design" value={d.id} data-title={d.title} checked={i === 0} class="sr-only" />
                    <Icon name={d.icon} size={18} class="shrink-0 text-glow" />
                    {d.title}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="reveal card p-5 sm:p-7">
            <legend class="sr-only">Шаг 3. Как получить</legend>
            <p class="flex items-center gap-3 font-display text-lg font-bold">
              <span class="grid size-8 place-items-center rounded-full bg-deep text-sm text-white">3</span> Как получить
            </p>
            <div class="mt-5 grid gap-2 sm:grid-cols-3">
              {
                certificate.delivery.map((d, i) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-line bg-ink/40 p-3 text-sm font-semibold transition hover:border-glow/60 has-[:checked]:border-glow has-[:checked]:bg-deep/30 has-[:checked]:shadow-glow-sm has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-glow">
                    <input type="radio" name="delivery" value={d.id} data-title={d.title} checked={i === 0} class="sr-only" />
                    <Icon name={d.icon} size={18} class="shrink-0 text-glow" />
                    {d.title}
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <aside class="reveal lg:sticky lg:top-28 lg:self-start" style="--d:120ms">
          <div class="card overflow-hidden">
            <div class="blueprint relative p-6">
              <p class="eyebrow">Ваш сертификат</p>
              <p class="mt-3 font-display text-xl font-bold" data-cert-title>Любая активность</p>
              <p class="price mt-2 text-3xl text-gradient" data-cert-price>номинал на выбор</p>
            </div>
            <dl class="grid gap-3 p-6 text-sm">
              <div class="flex justify-between gap-4"><dt class="text-muted">Оформление</dt><dd class="text-right font-bold" data-cert-design></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">Получение</dt><dd class="text-right font-bold" data-cert-delivery></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">Цена оформления</dt><dd class="text-right font-bold">по запросу</dd></div>
            </dl>
            <div class="border-t border-line p-6">
              <a href={fallback} class="btn btn-hot btn-lg w-full" data-book data-service="sertifikat" data-cert-order rel="noopener">
                Заказать <Icon name="gift" size={18} />
              </a>
              <p class="mt-3 text-xs text-muted">{pricesMeta.disclaimer}</p>
            </div>
          </div>
        </aside>
      </form>
    </div>
  </section>
</Base>

<script>
  import { initCertBuilder } from '@/scripts/cert-builder';
  initCertBuilder();
</script>
