---
import FinalCta from '@/components/blocks/FinalCta.astro';
import LocationCard from '@/components/blocks/LocationCard.astro';
import MapEmbed from '@/components/blocks/MapEmbed.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Footnote from '@/components/ui/Footnote.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { pages } from '@/data/pages';
import { hours, instagram, locations, phones, reviewPlatforms, socials } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { telHref } from '@/lib/format';
import { breadcrumbsLd, placesLd } from '@/lib/schema';

const meta = pages.contacts;
const origin = String(Astro.site);
---

<Base
  title={meta.title}
  description={meta.description}
  path={meta.path}
  jsonLd={[breadcrumbsLd(origin, [{ name: meta.crumb, path: meta.path }]), ...placesLd(origin)]}
>
  <PageHero
    compact
    eyebrow="Две площадки клуба"
    title="Контакты и как добраться"
    lead="Снегоходы и квадроциклы — в посёлке Мирный. Гидроциклы и флайборд — в Боровом Матюшине на Волге. Проверьте адрес перед выездом."
    crumbs={[{ name: meta.crumb, path: meta.path }]}
  />

  <section class="section !pt-12" aria-labelledby="contacts-title">
    <div class="container-x grid gap-5 lg:grid-cols-3">
      <h2 id="contacts-title" class="sr-only">Телефоны и мессенджеры</h2>
      <div class="reveal card p-6 sm:p-8">
        <p class="eyebrow mb-4">Телефоны</p>
        <ul class="grid gap-3">
          {
            phones.map((p) => (
              <li>
                <a href={telHref(p.e164)} class="inline-flex items-center gap-3 text-xl font-extrabold hover:text-glow">
                  <Icon name="phone" size={20} class="text-glow" />
                  {p.display}
                </a>
                {p.note && <span class="block pl-8 text-sm text-muted">{p.note}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal card p-6 sm:p-8" style="--d:80ms">
        <p class="eyebrow mb-4">Мессенджеры</p>
        <ul class="grid gap-2">
          {
            socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="flex items-center justify-between gap-3 rounded-xl border border-line px-4 py-3 transition hover:border-glow hover:shadow-glow-sm">
                  <span class="flex items-center gap-3 font-bold">
                    <Icon name={s.icon} size={20} class="text-glow" />
                    {s.label}
                  </span>
                  <span class="truncate text-sm text-muted">{s.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-muted">
          Instagram: <a href={instagram.url} target="_blank" rel="noopener" class="hover:text-text">{instagram.handle}</a>
        </p>
      </div>
      <div class="reveal card p-6 sm:p-8" style="--d:160ms">
        <p class="eyebrow mb-4">Режим работы</p>
        <p class="text-lg font-bold">{hours.label}<span class="clarify" title="Уточняйте у администратора">*</span></p>
        <p class="mt-2 text-sm text-muted">{hours.note}.</p>
        <p class="eyebrow mt-8 mb-4">Отзывы о клубе</p>
        <div class="flex flex-wrap gap-2">
          {
            reviewPlatforms.map((p) => (
              <a href={p.url} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">
                {p.label === 'Яндекс Картах' ? 'Яндекс Карты' : p.label}
                <Icon name="external-link" size={14} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    locations.map((l, i) => (
      <section class:list={[i === 0 ? 'slant bg-surface-grad' : 'section']} aria-labelledby={`loc-${l.id}`}>
        <div class="container-x">
          <SectionHead id={`loc-${l.id}`} eyebrow={`Площадка ${i + 1}`} title={l.title} lead={`${l.locality}, ${l.street}`} />
          <div class="mt-8 grid gap-5 lg:grid-cols-2">
            <LocationCard loc={l} index={i} />
            <MapEmbed points={[l]} class="reveal min-h-[22rem]" />
          </div>
          {l.streetClarify && <Footnote class="mt-3" />}
        </div>
      </section>
    ))
  }

  <FinalCta title="Напишите или оставьте заявку" />
</Base>
