---
import Faq from '@/components/blocks/Faq.astro';
import FinalCta from '@/components/blocks/FinalCta.astro';
import Gallery from '@/components/blocks/Gallery.astro';
import LocationCard from '@/components/blocks/LocationCard.astro';
import MapEmbed from '@/components/blocks/MapEmbed.astro';
import Promos from '@/components/blocks/Promos.astro';
import TourScheme from '@/components/blocks/TourScheme.astro';
import Videos from '@/components/blocks/Videos.astro';
import PageHero from '@/components/sections/PageHero.astro';
import BookButton from '@/components/ui/BookButton.astro';
import Icon from '@/components/ui/Icon.astro';
import PriceTag from '@/components/ui/PriceTag.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { faqFor } from '@/data/faq';
import { pages } from '@/data/pages';
import { jetBeachPrices, jetFleet, jetFormats, jetModelPicker, jetPrograms, jetTours, minPrice, pricesMeta } from '@/data/prices';
import { promosFor } from '@/data/promos';
import { location } from '@/data/site';
import { videos } from '@/data/videos';
import Base from '@/layouts/Base.astro';
import { formatPrice } from '@/lib/format';
import { servicePageLd } from '@/lib/schema';

const meta = pages.gidrocikl;
const origin = String(Astro.site);
const loc = location('santa');
---

<Base
  title={meta.title}
  description={meta.description}
  path={meta.path}
  jsonLd={servicePageLd(origin, { name: 'Прокат гидроциклов', path: meta.path, crumb: meta.crumb, serviceId: 'gidrocikl', location: 'santa' })}
>
  <PageHero
    photo="jet-splash"
    eyebrow="Летний сезон · Боровое Матюшино"
    title="Прокат и катание на гидроциклах в Казани"
    lead="В клубе более 15 гидроциклов Yamaha — под любую задачу: от спокойного семейного отдыха до экстремального катания и больших туров по Волге."
    crumbs={[{ name: meta.crumb, path: meta.path }]}
    service="gidrocikl"
    facts={[
      { icon: 'ticket', label: 'Стоимость', value: formatPrice(minPrice('gidrocikl')) },
      { icon: 'waves', label: 'Парк', value: `${jetFleet.count} Yamaha` },
      { icon: 'baby', label: 'Дети', value: 'с 3 лет' },
      { icon: 'map-pin', label: 'Где', value: 'санаторий «Санта»' },
    ]}
    secondary={{ label: 'Программы и туры', href: '#programmy', icon: 'route' }}
  />

  <!-- Форматы -->
  <section class="section" aria-labelledby="formats-title">
    <div class="container-x">
      <SectionHead id="formats-title" eyebrow="Три формата" title="Как можно покататься" lead="Начните у пляжа, разгонитесь на трассе по буям или отправьтесь в тур с инструктором." />
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {
          jetFormats.map((f, i) => (
            <li class="reveal card card-hover flex flex-col p-6 sm:p-7" style={`--d:${i * 90}ms`}>
              <div class="flex items-center justify-between">
                <span class="grid size-12 place-items-center rounded-2xl bg-deep/25 text-glow ring-1 ring-glow/30">
                  <Icon name={f.icon} size={24} />
                </span>
                <span class="chip">{f.age}</span>
              </div>
              <h3 class="mt-5 font-display text-xl font-bold">{f.title}</h3>
              <p class="mt-2 flex-1 text-sm text-muted">{f.text}</p>
              <div class="mt-5 grid gap-1 border-t border-line pt-4">
                {f.prices.length ? (
                  f.prices.map((p) => (
                    <p class="flex items-baseline justify-between gap-2">
                      <span class="text-sm text-muted">{p.unit}</span>
                      <PriceTag price={p.price} class="text-lg" />
                    </p>
                  ))
                ) : (
                  <a href="#tury" class="inline-flex items-center gap-2 text-sm font-bold text-glow hover:text-text">
                    Цены — в турах ниже <Icon name="arrow-right" size={16} />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Пляжный прайс + подбор модели -->
  <section class="slant bg-surface-grad" aria-labelledby="beach-title">
    <div class="container-x grid gap-8 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow mb-3">Пляжный формат</p>
        <h2 id="beach-title" class="h-section">Прайс у пляжа</h2>
        <ul class="card mt-8 divide-y divide-line">
          {
            jetBeachPrices.map((p) => (
              <li class="flex items-center justify-between gap-4 px-5 py-4">
                <span class="font-semibold">{p.label}</span>
                <span class="flex items-center gap-3">
                  <PriceTag price={p.price} class="text-lg" />
                  <BookButton service="gidrocikl" program={p.id} size="sm" label="Бронь" icon={false} class="hidden sm:inline-flex" />
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted">{pricesMeta.disclaimer}</p>
      </div>
      <div class="reveal" style="--d:120ms">
        <p class="eyebrow mb-3">Подбор модели</p>
        <h2 class="h-section">Какой гидроцикл выбрать</h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            jetModelPicker.map((m) => (
              <li class="card p-5">
                <span class="flex items-center gap-2 text-sm font-bold text-glow">
                  <Icon name={m.icon} size={18} />
                  {m.who}
                </span>
                <p class="mt-2 font-display text-lg font-bold">{m.models.join(', ')}</p>
              </li>
            ))
          }
        </ul>
        <div class="card mt-3 grid gap-3 p-5 text-sm">
          <p class="flex items-center gap-3"><Icon name="gauge" size={18} class="shrink-0 text-glow" /> {jetFleet.count} {jetFleet.text}: до {jetFleet.top}</p>
          <p class="flex items-center gap-3"><Icon name="baby" size={18} class="shrink-0 text-glow" /> {jetFleet.kids}</p>
          <p class="flex items-center gap-3"><Icon name="star" size={18} class="shrink-0 text-hot" /> {jetFleet.advice}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Программы -->
  <section id="programmy" class="section" aria-labelledby="programs-title">
    <div class="container-x">
      <SectionHead id="programs-title" eyebrow="7 программ" title="Программы: гидроцикл + сап" lead="Готовые наборы на 1–3 человек — выберите по времени и составу компании." />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          jetPrograms.map((p, i) => (
            <li class="reveal" style={`--d:${(i % 4) * 70}ms`}>
              <article class:list={['card card-hover flex h-full flex-col p-5 sm:p-6', p.badge === 'Хит' && 'border-hot/50']}>
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-display text-xl font-bold">«{p.name}»</h3>
                  {p.badge && <span class:list={['chip text-xs', p.badge === 'Хит' && 'chip-hot']}>{p.badge}</span>}
                </div>
                <p class="mt-2 flex items-center gap-2 text-sm text-muted">
                  <Icon name="users" size={16} class="text-glow" /> {p.people}
                </p>
                <ul class="ticks mt-4 flex-1 text-sm">
                  {p.includes.map((x) => <li>{x}</li>)}
                </ul>
                {p.note && <p class="mt-3 text-xs font-semibold text-[#ffb48a]">{p.note}</p>}
                <div class="mt-5 grid gap-2 border-t border-line pt-4">
                  {p.variants.map((v) => (
                    <div class="flex items-center justify-between gap-2">
                      <div>
                        {v.label && <p class="text-xs text-muted">{v.label}</p>}
                        <PriceTag price={v.price} class="text-xl" />
                      </div>
                      <BookButton service="gidrocikl" program={v.id} size="sm" label="Бронь" icon={false} />
                    </div>
                  ))}
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Туры -->
  <section id="tury" class="slant bg-surface-grad" aria-labelledby="tours-title">
    <div class="container-x">
      <SectionHead id="tours-title" eyebrow="Туры с инструктором" title="Туры по Волге" lead="Прогулка с инструктором на отдельном гидроцикле — до 3 человек и 150 кг на одном гидроцикле." />
      <ul class="mt-10 grid gap-5 lg:grid-cols-2">
        {
          jetTours.map((t, i) => (
            <li class="reveal" style={`--d:${(i % 2) * 90}ms`}>
              <article class="card flex h-full flex-col gap-5 p-5 sm:p-7">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="font-display text-2xl font-bold">«{t.name}»</h3>
                    <p class="mt-1 flex items-center gap-2 text-sm text-muted">
                      <Icon name="timer" size={16} class="text-glow" /> {t.duration}
                    </p>
                  </div>
                  {t.badge && <span class="chip chip-hot">{t.badge}</span>}
                </div>
                <TourScheme tour={t} />
                <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  {t.route.map((r, ri) => (
                    <li class="flex items-center gap-2">
                      {ri > 0 && <Icon name="arrow-right" size={14} class="text-glow" />}
                      <span>{r}</span>
                    </li>
                  ))}
                </ol>
                {t.extras && (
                  <ul class="flex flex-wrap gap-2">
                    {t.extras.map((x) => (
                      <li class="chip text-xs">{x}</li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto flex flex-wrap items-end justify-between gap-3 border-t border-line pt-4">
                  <div>
                    {t.variants.length > 1 ? (
                      <p class="flex flex-wrap gap-x-3 gap-y-1">
                        {t.variants.map((v) => (
                          <PriceTag price={v.price} class="text-lg" />
                        ))}
                      </p>
                    ) : (
                      <PriceTag price={t.variants[0]!.price} class="text-2xl" />
                    )}
                    {t.priceNote && <p class="text-xs text-muted">{t.priceNote}</p>}
                  </div>
                  <BookButton service="gidrocikl" program={t.variants[0]!.id} size="sm" label="Забронировать тур" />
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Promos items={promosFor('gidrocikl')} title="Бонусы на воде" slant={false} />

  <section class="section" aria-labelledby="place-title">
    <div class="container-x">
      <SectionHead id="place-title" eyebrow="Где катаемся" title="Боровое Матюшино, берег Волги" lead="Снегоходы и квадроциклы — в другом месте, в посёлке Мирный. Сюда — только за водой." />
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <LocationCard loc={loc} index={1} />
        <MapEmbed points={[loc]} class="reveal min-h-[22rem]" />
      </div>
    </div>
  </section>

  <Gallery photos={['jet-volga', 'jet-splash', 'jet-yamaha-pair', 'jet-duo', 'flyboard-arc']} title="Гидроциклы на Волге" />
  <Videos items={videos.filter((v) => v.services.includes('gidrocikl'))} title="Гидроциклы на видео" />
  <Faq items={faqFor('gidrocikl')} title="Вопросы о гидроциклах" />
  <FinalCta service="gidrocikl" title="Забронируйте гидроцикл" />
</Base>
