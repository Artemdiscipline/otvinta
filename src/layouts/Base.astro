---
import '@/styles/global.css';
import fontDisplay from '@/assets/fonts/unbounded-700-900.woff2?url';
import fontText from '@/assets/fonts/manrope-400-800.woff2?url';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import MobileBar from '@/components/layout/MobileBar.astro';
import BookingModal from '@/components/blocks/BookingModal.astro';
import { site } from '@/data/site';
import { organization } from '@/lib/schema';
import { absUrl, href } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  path: string;
  /** JSON-LD объекты этой страницы */
  jsonLd?: Record<string, unknown>[];
  /** Предзагрузка главного фото (LCP) */
  preload?: { avif: string; sizes: string };
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], preload, ogImage = '/og-image.jpg', noindex = false } = Astro.props;
const origin = Astro.site ?? site.url;
const canonical = absUrl(path, origin);
const og = absUrl(ogImage, origin);
const robots = noindex || __NOINDEX__ ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ld = [organization(String(origin)), ...jsonLd];
---

<!doctype html>
<html lang="ru" data-metrika={site.metrikaId ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="yandex-verification" content={site.yandexVerification} />
    <meta name="theme-color" content="#05070D" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.slogan}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    {
      preload && (
        <link rel="preload" as="image" type="image/avif" imagesrcset={preload.avif} imagesizes={preload.sizes} fetchpriority="high" />
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {
      /* Яндекс.Метрика. TODO: ID счётчика — задать site.metrikaId в src/data/site.ts.
         Цели: phone_click, whatsapp_click, telegram_click, max_click, lead_submit (src/scripts/metrika.ts). */
      site.metrikaId && (
        <script is:inline define:vars={{ id: site.metrikaId }}>
          (function (m, e, t, r, i, k, a) {
            m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
            m[i].l = 1 * new Date();
            k = e.createElement(t); a = e.getElementsByTagName(t)[0];
            k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
          window.ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
        </script>
      )
    }
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <BookingModal />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
